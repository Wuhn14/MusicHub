# Copie ce fichier en ".env" puis remplis les valeurs.
# Les ports sont ceux utilisés par chaque service sur ton serveur.

# Lidarr : Settings > General > API Key
LIDARR_URL=http://IP_DU_NAS:PORT_LIDARR
LIDARR_API_KEY=

# Prowlarr : Settings > General > API Key
PROWLARR_URL=http://IP_DU_NAS:PORT_PROWLARR
PROWLARR_API_KEY=

# Ton compte Navidrome
NAVIDROME_URL=http://IP_DU_NAS:PORT_NAVIDROME
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Facultatif :
# Dossier racine de Lidarr (sinon le premier dossier racine défini dans Lidarr)
# LIDARR_ROOT_FOLDER=/music
# Profil de qualité et de métadonnées (sinon les premiers de la liste)
# LIDARR_QUALITY_PROFILE_ID=
# LIDARR_METADATA_PROFILE_ID=
# Convertir en MP3 320 pour économiser la 4G
# NAVIDROME_TRANSCODE=mp3
# Analyser Navidrome quand les téléchargements se terminent
# AUTO_SCAN=true
