# Variables d'environnement de MusicHub (valeurs par défaut indiquées).
# Go ne lit pas les fichiers .env : exportez ces variables dans votre shell,
# ou copiez-les dans l'environnement de votre service (voir le README).

# Port d'écoute du serveur HTTP.
MUSICHUB_PORT=8080

# Dossier de la base de données interne, des caches (pochettes, conversions)
# et des fichiers envoyés en attente d'identification.
MUSICHUB_DATA=./data

# Dossier de votre musique : il est analysé, et les fichiers envoyés une fois
# identifiés y sont rangés (Artiste/Album (année)/NN - Titre). Les fichiers que
# vous y déposez vous-même ne sont jamais déplacés ni modifiés, sauf si vous
# l'activez dans les Réglages.
MUSICHUB_MUSIC=./music

# API MusicBrainz (catalogue mondial).
MUSICHUB_MB_URL=https://musicbrainz.org/ws/2

# Cover Art Archive (pochettes).
MUSICHUB_CAA_URL=https://coverartarchive.org

# API AcoustID (identification par empreinte audio). La clé AcoustID, facultative
# et gratuite, ne se met pas ici : chaque utilisateur la crée sur le site
# d'AcoustID et la saisit dans les Réglages de l'application.
MUSICHUB_ACOUSTID_URL=https://api.acoustid.org/v2

# Outils audio (nom dans le PATH ou chemin complet) : ffmpeg et ffprobe pour
# lire les fichiers et convertir à la volée, fpcalc (Chromaprint) pour les
# empreintes. L'image Docker les contient déjà.
MUSICHUB_FFMPEG=ffmpeg
MUSICHUB_FFPROBE=ffprobe
MUSICHUB_FPCALC=fpcalc
